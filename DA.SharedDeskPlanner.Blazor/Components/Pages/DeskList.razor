@page "/DeskList"
@using DA.SharedDeskPlanner.WebAPI.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@inherits DeskList_Code

<h3>DeskList</h3>
@{
	if (!Loading)
	{
		<QuickGrid TGridItem="Desk" Items="Desks?.AsQueryable()">
			<PropertyColumn	Title="Name" Property="@(d=>d.Name)"/>
			<PropertyColumn Title="Raum" Property="@(d=>GetRoomByDesk(d)!.Name)"/>
			<PropertyColumn Title="Bemerkung" Property="@(d=>d.Remarks)"></PropertyColumn>
			<PropertyColumn Title="heute gebucht" Property="@(d=>IsDeskBookedToday(d))" />
		</QuickGrid>
	}
	else
	{
		<span>Lade Formular...</span>
	}
}
