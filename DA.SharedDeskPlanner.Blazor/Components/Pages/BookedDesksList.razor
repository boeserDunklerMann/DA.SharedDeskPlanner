@page "/BookedDesksList"
@using DA.SharedDeskPlanner.WebAPI.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@inherits PageBase

<h3>Hausmeisteransicht</h3>
@{
	if (!Loading)
	{
		<h4>heute gebuchte Tische und Räume</h4>
		<QuickGrid TGridItem="Booking" Items="TodaysBookings">
			<PropertyColumn Title="Zweck" Property="@(b=>b.Name)"/>
			<PropertyColumn Title="Schreibtisch" Property="@(b=>GetDesknameFromBooking(b))" />
			<PropertyColumn Title="Raum" Property="@(b=>GetRoomnameFromBooking(b))" />
			<PropertyColumn Title="von wem" Property="@(b=>GetUsernameForBookedDesk(b.DeskId.HasValue?b.DeskId.Value:0))" />
			<PropertyColumn Title="gebucht von" Property="@(b=>b.BookingStart)" />
			<PropertyColumn Title="gebucht bis" Property="@(b=>b.BookingEnd)" />
		</QuickGrid>
	}
}
