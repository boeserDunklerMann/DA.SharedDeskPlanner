@rendermode InteractiveServer
@page "/Users"
@inject NavigationManager navMgr
@inherits PageBase

<h3>Benutzer</h3>
@{
	if (!Loading)
	{
		<QuickGrid TGridItem="DA.SharedDeskPlanner.WebAPI.Client.Models.User" Items="@Users!.AsQueryable()">
			<PropertyColumn Title="Name" Property="@(u=>u.Name)" Sortable="true"/>
			<PropertyColumn Title="Vorname" Property="@(u=>u.FirstName)" Sortable="true" />
			<PropertyColumn Title="Nachname" Property="@(u=>u.LastName)" Sortable="true" />
			<PropertyColumn Title="erstellt am" Property="@(u=>u.CreationDate)" Sortable="true" />
			<TemplateColumn Title="Actions" Context="user">
				<input type="image" src="img/delete.png" width="15" height="15"
					   @onclick="(a)=>DelUserAsync(user)" />
			</TemplateColumn>
		</QuickGrid>
	}
	@if (editContext != null && !Loading)
	{
	<div>
	<h4>BenutzerIn anlegen</h4>
		<EditForm EditContext="@editContext" OnValidSubmit="NewUserSubmittedAsync" FormName="CreationForm">
		<DataAnnotationsValidator/>

		<div class="form-group">
			<label>Nachname:</label>
			<InputText @bind-Value="@NewUser.LastName"/>
			<ValidationMessage For="@(()=>NewUser.LastName)"/>

			<br />
			<label>Vorname:</label>
			<InputText @bind-Value="@NewUser.FirstName" />
			<ValidationMessage For="@(()=>NewUser.FirstName)"/>

			<br />
			<label>Name/Kürzel:</label>
			<InputText @bind-Value="@NewUser.Name" />
		</div>
			<button type="submit"
				class="btn btn-primary">create</button>
		</EditForm>
	</div>
	} else
	{
		<span>Lade Formular...</span>
	}
}