<UserControl x:Class="DA.SharedDeskPlanner.Wpf.Controls.UsersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DA.SharedDeskPlanner.Wpf.Controls"
			 xmlns:vm="clr-namespace:DA.SharedDeskPlanner.Wpf.MVVM"
             mc:Ignorable="d" 
             d:DesignHeight="460" d:DesignWidth="800">
	<UserControl.DataContext>
		<vm:MainWindowViewModel/>
	</UserControl.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="160"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Grid.Row="0">Benutzer</Label>
		<DataGrid Width="auto" Background="LightBlue" Grid.Row="1" ItemsSource="{Binding Users, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}">
		</DataGrid>
		<!--Control, neuer User-->
		<StackPanel Orientation="Vertical" Grid.Row="2">
			<Label>Vorname</Label>
			<TextBox Text="{Binding NewUser.FirstName}"/>
			<Label>Nachname</Label>
			<TextBox Text="{Binding NewUser.LastName}"/>
			<Label>Initialien</Label>
			<TextBox Text="{Binding NewUser.Name}"/>
			<Button Command="{Binding CreateUser}">Anlegen</Button>
		</StackPanel>
	</Grid>
</UserControl>
